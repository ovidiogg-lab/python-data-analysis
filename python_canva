import pandas as pd
import ast

# Load the data
df = pd.read_csv('clases-de-español.csv')

# Inspect the first few rows and column names
print("Columns:", df.columns.tolist())
print(df.head())


# Clean and sort data
df_clean = df.copy()

# Remove '$' and commas from CPC
df_clean['CPC (Global)'] = df_clean['CPC (Global)'].str.replace('$', '').str.replace(',', '').astype(float)

# Sort by Volume
df_clean = df_clean.sort_values(by='Search Volume (Global)', ascending=False)

# 1. Main Data for Bar/Scatter charts (Top 15 keywords)
top_15 = df_clean[['Keyword', 'Search Volume (Global)', 'CPC (Global)', 'Competition (Global)']].head(15)
top_15.to_csv('BigClick_Top_Keywords.csv', index=False)

# 2. Trend Data for Line Chart (Top 5 keywords)
# Identify columns that look like dates (they contain 2025 or 2026)
date_cols = [c for c in df.columns if '2025' in c or '2026' in c]

# Take top 5 keywords
top_5_trends = df_clean.head(5)
trend_data = top_5_trends[['Keyword'] + date_cols].set_index('Keyword').T

# Clean the index (dates) a bit for Canva if possible
trend_data.index = trend_data.index.str.replace(' (Global)', '', regex=False)

# Reverse index to show chronological order (assuming they are latest to oldest)
trend_data = trend_data.iloc[::-1]

trend_data.to_csv('BigClick_Tendencias_Semanales.csv')

print("Files created: BigClick_Top_Keywords.csv and BigClick_Tendencias_Semanales.csv")
print(top_15.head())

def categorizar(seg):
    seg = seg.lower()
    if "fútbol" in seg or "deporte" in seg or "fitness" in seg:
        return "Deporte"
    if "tecnología" in seg:
        return "Tecnología"
    if "invers" in seg or "finanzas" in seg or "banca" in seg:

import pandas as pd
import numpy as np
import unicodedata

def normalizar_texto(texto):
    """Elimina acentos y convierte a minúsculas para comparaciones precisas."""
    if pd.isna(texto): return ""
    # Eliminar acentos
    texto = unicodedata.normalize('NFKD', str(texto)).encode('ascii', 'ignore').decode('utf-8')
    return texto.lower().strip()

def categorizar_v2(seg):
    seg_limpio = normalizar_texto(seg)
    if not seg_limpio or "all visitors" in seg_limpio:
        return "Retargeting / General"

    # Diccionario de patrones: {Categoría: [palabras clave]}
    reglas = {
        "Tecnología": ["tecnolog", "it", "software", "comput"],
        "Empleo/B2B": ["empleo", "trabajo", "ejecutivo", "administracion", "empresa", "empresario", "b2b"],
        "Viajes": ["viaje", "turismo", "vuelo", "hotel"],
        "Belleza": ["belleza", "bienestar", "cuidado personal", "peluqueria"],
        "Social Media": ["redes sociales", "social media", "influencer"],
        "Moda": ["ropa", "complemento", "moda", "calzado"],
        "Demográfico/Familia": ["hijos", "adolescente", "padres", "casado", "soltero"],
        "Educación": ["posgrado", "universitario", "grado", "estudiante"],
        "Finanzas": ["invers", "finanzas", "banca", "dinero"]
    }

    for categoria, palabras in reglas.items():
        if any(p in seg_limpio for p in palabras):
            return categoria
            
    return "Otros (Sin clasificar)"

# Aplicamos la nueva lógica
df_seg["Categoría"] = df_seg["Segmento de audiencia"].apply(categorizar_v2)






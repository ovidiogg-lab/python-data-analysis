# 2. Creación de la Matriz de Cuadrantes (Engagement vs. Intent)
# Definimos promedios como puntos de corte
mean_ctr = df_seg["CTR"].mean()
mean_cr = df_seg["Tasa de conv."].mean()

def clasificar_cuadrante(row):
    if row["CTR"] >= mean_ctr and row["Tasa de conv."] >= mean_cr:
        return "Estrellas (Escalar)"
    if row["CTR"] < mean_ctr and row["Tasa de conv."] >= mean_cr:
        return "Joyas Ocultas (Mejorar CTR/Ads)"
    if row["CTR"] >= mean_ctr and row["Tasa de conv."] < mean_cr:
        return "Atractivos pero No Compran (Revisar LP)"
    return "Bajo Rendimiento (Eliminar/Reducir)"

df_seg["Cuadrante"] = df_seg.apply(clasificar_cuadrante, axis=1)

# 3. Visualización de Cuadrantes de Rendimiento

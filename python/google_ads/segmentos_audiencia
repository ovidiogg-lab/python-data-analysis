# 1. Definición de funciones de limpieza robustas
def clean_pct(series):
    """
    Limpia columnas de porcentaje: quita %, espacios, normaliza decimales 
    y maneja placeholders de Google Ads.
    """
    return (
        series.astype(str)
        .str.strip()  # Elimina espacios en blanco como el de ' --'
        .str.replace("%", "", regex=False)
        .str.replace(",", ".", regex=False)
        .replace(["--", "—", "-", ""], np.nan) # Maneja múltiples variantes de nulos
        .astype(float)
    )

def clean_num(series):
    """
    Limpia columnas numéricas: quita separadores de miles y maneja nulos.
    """
    return (
        series.astype(str)
        .str.strip()
        .str.replace(",", "", regex=False) # Quita comas de miles
        .replace(["--", "—", "-", ""], np.nan)
        .astype(float)
    )


# Carga automáticamente un archivo CSV o Excel aunque no tenga extensión, 
# detectando por sí sola el tipo de archivo, encoding y separador, 
# y lo devuelve como un DataFrame de pandas.

def cargar_archivo(path):
    with open(path, "rb") as f:
        inicio = f.read(4)

    # Excel moderno empieza con PK
    if inicio[:2] == b"PK":
        print("📊 Archivo Excel detectado (sin extensión)")
        return pd.read_excel(path)

    # Asumir CSV
    with open(path, "rb") as f:
        raw = f.read()
        encoding = chardet.detect(raw)["encoding"]

    print(f"📄 Archivo CSV detectado (sin extensión) | Encoding: {encoding}")

    for sep in [",", ";", "\t"]:
        try:
            df = pd.read_csv(path, encoding=encoding, sep=sep)
            print(f"✅ Separador detectado: '{sep}'")
            return df
        except:
            pass

    raise ValueError("No se pudo leer el archivo como CSV o Excel")

# Agrupar por término y sumar el coste, aquí no es ptl, se puede ordenar de cualquier otra forma esto es un ejemplo
top_10_coste = (
    df_sin_geriatra
    .groupby("Término de búsqueda", as_index=False)["Coste"]
    .sum()
    .sort_values("Coste", ascending=False)
    .head(10)
)


# Grafica de barras horizontales
plt.figure()
plt.barh(
    top_10_coste["Término de búsqueda"],
    top_10_coste["Coste"]
)
plt.xlabel("Coste")
plt.ylabel("Término de búsqueda")
plt.title("Top 10 términos de búsqueda con mayor coste (sin 'geriatra')")
plt.gca().invert_yaxis()  # el mayor arriba
plt.show()
